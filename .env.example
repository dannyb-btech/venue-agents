# Copy to .env for local development. Never commit .env.
# In Azure these come from Key Vault references, not env files.

ENVIRONMENT=local
STAMP_ID=canary-local

# Database (docker compose)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/venue_agents
CATALOG_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/catalog

# Model access: AI gateway (APIM) in front of Claude on Foundry.
# Local dev may point straight at a Foundry dev deployment.
MODEL_GATEWAY_URL=
MODEL_GATEWAY_KEY=
MODEL_TRIAGE=claude-haiku
MODEL_DRAFT=claude-sonnet
MODEL_REASONING=claude-opus

# Durable Task Scheduler emulator
DTS_ENDPOINT=http://localhost:8080
DTS_TASKHUB=default

# Connector sandbox credentials (dev/demo orgs only, never production venue credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TANDA_ACCESS_TOKEN=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
SEVENROOMS_CLIENT_ID=
SEVENROOMS_CLIENT_SECRET=
SEVENROOMS_VENUE_GROUP_ID=
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
STRIPE_RESTRICTED_KEY=
