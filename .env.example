# Copy to .env for local development. Never commit .env.
# In Azure these come from Key Vault references, not env files.

ENVIRONMENT=local
STAMP_ID=canary-local
SERVICE_NAME=venue-agents
LOG_LEVEL=INFO

# Secrets and telemetry (va_core.settings). Locally, leave KEY_VAULT_URL empty to read secrets from
# this file; outside local/test, KEY_VAULT_URL and MANAGED_IDENTITY_CLIENT_ID are required.
# No APPLICATIONINSIGHTS_CONNECTION_STRING = traces stay in-process (nothing exported).
KEY_VAULT_URL=
MANAGED_IDENTITY_CLIENT_ID=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Database (docker compose). Runtime code uses DATABASE_URL: `va_app_local` is a member of va_app,
# so RLS applies. DATABASE_ADMIN_URL (superuser `app`, bypasses RLS) is for migrations and test setup
# only. va_app_local comes from infra/local/postgres/init.sql: on an older volume, recreate it
# (docker compose down && docker volume rm venue-agents_pg-data && docker compose up -d).
DATABASE_URL=postgresql+psycopg://va_app_local:va_app_local@127.0.0.1:5432/venue_agents
DATABASE_ADMIN_URL=postgresql+psycopg://app:app@127.0.0.1:5432/venue_agents

# Control plane (ADR-0017). The catalog is the global database; `va_catalog_local` is a va_catalog
# member (no RLS bypass). CATALOG_ADMIN_URL owns the catalog schema and registers stamps
# (`uv run python -m va_control_plane register-stamp ...`). The control plane logs in to each stamp
# as a va_provision member; locally its password is the secret stamp-<id>-provision-db-password.
# On an existing volume, add these logins with infra/local/postgres/control-plane-roles.sql.
# In Azure all of these logins are managed identities (Entra tokens), not passwords.
CATALOG_DATABASE_URL=postgresql+psycopg://va_catalog_local:va_catalog_local@127.0.0.1:5432/catalog
CATALOG_ADMIN_URL=postgresql+psycopg://app:app@127.0.0.1:5432/catalog
STAMP_CANARY_LOCAL_PROVISION_DB_PASSWORD=va_provision_local
# Local-only bearer token for the control plane API (32+ chars; refused outside local/test).
CONTROL_PLANE_DEV_TOKEN=

# Model access: AI gateway (APIM) in front of Claude on Foundry.
# Only when ENVIRONMENT=local may this point straight at a Foundry dev deployment (ADR-0016);
# every deployed stamp goes through APIM.
MODEL_GATEWAY_URL=
MODEL_GATEWAY_KEY=
MODEL_TRIAGE=claude-haiku
MODEL_DRAFT=claude-sonnet
MODEL_REASONING=claude-opus

# Durable Task Scheduler emulator
DTS_ENDPOINT=http://localhost:8080
DTS_TASKHUB=default

# Azurite (docker compose). Public well-known emulator account, not a secret.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;

# Service Bus emulator (opt-in: docker compose --profile servicebus up -d).
# SAS_KEY_VALUE is the emulator's literal placeholder, not a secret.
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
# Setting ACCEPT_EULA=Y accepts the Service Bus emulator and SQL Server EULAs (links in docker-compose.yml).
# ACCEPT_EULA=
# MSSQL_SA_PASSWORD=   (local only; SQL Server strong-password rules, 8+ chars)

# Connector sandbox credentials (dev/demo orgs only, never production venue credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TANDA_ACCESS_TOKEN=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
SEVENROOMS_CLIENT_ID=
SEVENROOMS_CLIENT_SECRET=
SEVENROOMS_VENUE_GROUP_ID=
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
STRIPE_RESTRICTED_KEY=
